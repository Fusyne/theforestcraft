<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <AssemblyName>ForestCraft</AssemblyName>
    <!-- scripts\build.ps1 passes -p:ForestDir=... (found through Steam). Override by hand if needed. -->
    <ForestDir Condition="'$(ForestDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\The Forest</ForestDir>
    <ForestManaged Condition="'$(ForestManaged)' == ''">$(ForestDir)\TheForest_Data\Managed</ForestManaged>
    <BepInExCore Condition="'$(BepInExCore)' == '' And Exists('$(ForestDir)\BepInEx\core\BepInEx.dll')">$(ForestDir)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == ''">..\.tools\bepinex\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ForestManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ForestManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="bolt"><HintPath>$(ForestManaged)\bolt.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ForestManaged)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
